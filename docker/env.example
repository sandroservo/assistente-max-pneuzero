# Autor: Sandro Servo
# Site: https://cloudservo.com.br
#
# Variáveis para o Docker Compose (PostgreSQL + pgvector)
# Copie este arquivo para .env na raiz do projeto e ajuste os valores.
#
# Uso: cp docker/env.example .env

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secretaria
POSTGRES_PORT=5432

# ===== Prisma (DATABASE_URL) =====
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/secretaria?schema=public"
